# === USER DATA (DEFAULT: IGNORE EVERYTHING) ===
# We ignore the whole user_data folder by default to protect privacy
user_data/

# === EXCEPTIONS: SHARE THESE DEFAULT CONFIGS ===
# The '!' symbol tells Git to track these specific folders despite the rule above
!user_data/sampler_data/
!user_data/stop_patterns_data/
!user_data/budget_strategy_data/

# === KEEP THESE PRIVATE (NO EXCEPTIONS) ===
# These contain personal chats, custom characters, images, and cache files
# They will remain ignored because of the 'user_data/' rule at the top
# user_data/chat_data/
# user_data/chat_messages/
# user_data/character_data/
# user_data/character_images/
# user_data/context_data/
# user_data/kv_caches/
# user_data/extensions/

llama/