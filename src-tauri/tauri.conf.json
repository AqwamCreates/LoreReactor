{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoreReactor",
  "version": "1.0.0",
  "identifier": "com.lorereactor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:4444",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoreReactor",
        "width": 1200,
        "height": 800,
        "resizable": true
      },
      {
        "label": "companion-overlay",
        "title": "Companion Overlay",
        "url": "/?overlay=true",
        "width": 360,
        "height": 540,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}